{
  "name": "negative-filter",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome MV3 extension that hides items that fail your filters from any list / carousel / grid.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.config.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
